# Common Ground settings. Copy to .env (git-ignored) and fill in locally; never commit .env.
# Every value below is empty on purpose: an empty value means "use the built-in default".
# To keep the key outside the repository instead, point at your own key file:
#   COMMON_GROUND_ENV_FILE=/path/to/qloo.env python3 -m common_ground serve

# Your own Qloo hackathon key. It only works against hackathon.api.qloo.com. Leave it empty to
# run on the synthetic sample data, with a banner on every page saying Qloo is not being called.
QLOO_API_KEY=

# Source of data: live (needs QLOO_API_KEY) or fake (synthetic sample data, no network).
# Empty means live when QLOO_API_KEY is set, else fake. A missing key never falls back silently.
# Live also refuses to run until the response shapes have been checked against real Qloo
# responses (the key-day probe).
COMMON_GROUND_PROVIDER=

# Most live Qloo calls one outing may spend (default 30, which fits six people with three
# favourites each: 26 calls). Only a person can lift it, up to 60.
COMMON_GROUND_CALL_LIMIT=

# Most live Qloo calls, in any 24 hours, in comparisons the agent starts on its own for one
# workspace (default 48). Kept in memory, so it restarts with the server.
COMMON_GROUND_AGENT_CALLS_PER_DAY=

# Most live Qloo calls the whole server makes per UTC day (default 300). Set it from the quota
# your key's email states. Kept in memory: it resets at UTC midnight and whenever the server
# restarts, so it bounds one run of the server, not a calendar day.
COMMON_GROUND_DAILY_LIVE_CALLS=

# Seconds a Qloo response stays in the private in-memory cache (default 86400).
COMMON_GROUND_CACHE_TTL_S=

# Address to bind (default 127.0.0.1). A host sets 0.0.0.0, and then needs an allowed host (below).
COMMON_GROUND_BIND=

# Comma-separated Host header values (no port) the server answers to, besides 127.0.0.1, localhost
# and [::1]. It is read whatever the bind is: behind a reverse proxy the server stays on 127.0.0.1
# and still receives the public name in Host. On Render the service's own RENDER_EXTERNAL_HOSTNAME
# is read automatically, so this can stay empty there. A non-loopback bind with no allowed host
# does not start.
COMMON_GROUND_ALLOWED_HOSTS=

# Set to 1 only behind a reverse proxy that appends the client address to X-Forwarded-For (a
# host's proxy does). The right-most value is then the client address used for the limit on
# creating workspaces; leave it empty on a local run, where the peer address is used.
COMMON_GROUND_TRUST_PROXY=

# Port to listen on (default 8761). A host's PORT, below, wins when it is set.
COMMON_GROUND_PORT=

# The port a host injects (Render: 10000). Leave it empty on your own machine.
PORT=
